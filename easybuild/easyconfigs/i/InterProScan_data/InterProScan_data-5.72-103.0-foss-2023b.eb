easyblock = 'Binary'

name = 'InterProScan_data'
version = '5.72-103.0'

homepage = 'https://www.ebi.ac.uk/interpro/'
# also https://github.com/ebi-pf-team/interproscan
description = """InterProScan is a sequence analysis application (nucleotide and protein sequences) that combines
 different protein signature recognition methods into one resource [data only]."""

# software_license = 'LicenseApachev2'

toolchain = {'name': 'foss', 'version': '2023b'}

source_urls = ['https://ftp.ebi.ac.uk/pub/software/unix/iprscan/%(version_major)s/%(version)s/alt/']
sources = ['interproscan-data-%(version)s.tar.gz']
checksums = ['9e095f46aa45859b10041938af1ce2f9']

dependencies = [
    ('InterProScan', '%(version)s'),
]

# NOTE finalize the data indexing that needs to be done before/at the first use
postinstallcmds = ['$EBROOTINTERPROSCAN/interproscan.sh || true']
# NOTE The regular InterProScan data package does not contain the lookup_service data way too large!
install_cmd = "tar xfz interproscan-data-%(version)s.tar.gz --directory %(installdir)s/ --strip-components=1 && rm -f interproscan-data-%(version)s.tar.gz && rm -rf $EBROOTINTERPROSCAN/data && ln -s %(installdir)s/data $EBROOTINTERPROSCAN/data"

sanity_check_paths = {
    'files': [],
    'dirs': ['data/antifam', 'data/cdd', 'data/gene3d', 'data/hamap', 'data/panther', 'data/pfam', 'data/phobius', 'data/pirsf', 'data/pirsr', 'data/prints', 'data/prosite', 'data/sfld', 'data/smart', 'data/superfamily', 'data/tmhmm'],
}

moduleclass = 'bio'
